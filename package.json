{
  "name": "@ganmahmud/agent-session-inspect",
  "version": "0.1.2",
  "description": "Local, read-only inspection tool, TUI, and Web dashboard for Codex agent session logs",
  "author": "Gan Mahmud",
  "license": "MIT",
  "homepage": "https://github.com/ganmahmud/agent-session-inspect#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ganmahmud/agent-session-inspect.git"
  },
  "bugs": {
    "url": "https://github.com/ganmahmud/agent-session-inspect/issues"
  },
  "keywords": [
    "codex",
    "agent",
    "tui",
    "dashboard",
    "session-inspector",
    "llm-logs",
    "sveltekit"
  ],
  "private": false,
  "type": "module",
  "bin": {
    "agent-session-inspect": "./dist/cli/src/cli.js"
  },
  "scripts": {
    "start": "node --no-warnings src/cli.ts",
    "dashboard:dev": "npm run dev --prefix dashboard",
    "dashboard:check": "npm run check --prefix dashboard",
    "build:cli": "./dashboard/node_modules/.bin/tsc -p tsconfig.build.json",
    "build:dashboard": "npm run build --prefix dashboard",
    "build": "npm run build:cli && npm run build:dashboard",
    "prepack": "npm run build",
    "test": "node --no-warnings --test test/*.test.ts",
    "check": "node --no-warnings --check src/cli.ts && node --no-warnings --check src/codex.ts && node --no-warnings --check src/catalog.ts && node --no-warnings --check src/detail.ts && node --no-warnings --check src/report.ts && node --no-warnings --check src/tui.ts"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "files": [
    "README.md",
    "LICENSE",
    "dist/cli",
    "dist/dashboard",
    "dashboard/package.json"
  ]
}
