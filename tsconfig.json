{
  "extends": "./tsconfig.build.json",
  "compilerOptions": {
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "erasableSyntaxOnly": true,
    "typeRoots": ["./node_modules/@types"],
    "types": ["node"]
  },
  "include": ["src/*.ts", "test/*.ts"],
  "exclude": ["dashboard", "dist", "node_modules"]
}
