{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "rootDir": ".",
    "outDir": "dist/cli",
    "strict": true,
    "skipLibCheck": true,
    "sourceMap": false,
    "declaration": false,
    "rewriteRelativeImportExtensions": true,
    "typeRoots": ["./src/dashboard/node_modules/@types"],
    "types": ["node"]
  },
  "include": ["src/*.ts"],
  "exclude": ["src/dashboard", "test", "dist"]
}
